{
  "title": "計算API SLO",
  "uid": "calc-slo",
  "description": "計算API(POST /api/calc・/api/calc/bulk・/api/calc/reverse)の SLO ダッシュボード。ADR-0407。p99 レイテンシ(目標 100ms 未満)と可用性(5xx 以外の割合)を、PrometheusRule の記録ルールで見る。",
  "tags": ["pokecalc", "calc", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "計算API p99 レイテンシ",
      "description": "calc_job:calc_request_duration_seconds:p99_5m(ADR-0407 §1・§3)。しきい値ラインは 100ms(SLO目標)。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "calc_job:calc_request_duration_seconds:p99_5m",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "計算API 可用性",
      "description": "calc_job:calc_availability_ratio:5m(ADR-0407 §1・§3)。5xx 以外を可用とみなす割合。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "calc_job:calc_availability_ratio:5m",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99(直近)",
      "description": "calc_job:calc_request_duration_seconds:p99_5m の直近の値。",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "calc_job:calc_request_duration_seconds:p99_5m"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "可用性(直近)",
      "description": "calc_job:calc_availability_ratio:5m の直近の値。",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "calc_job:calc_availability_ratio:5m"
        }
      ]
    }
  ]
}
