{
  "name": "pokecalc-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-api-types.mjs",
    "predev": "npm run --silent gen",
    "dev": "vite",
    "prebuild": "npm run --silent gen",
    "build": "npm run typecheck && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "pretypecheck": "npm run --silent gen",
    "typecheck": "node ./node_modules/typescript7/bin/tsc --noEmit",
    "prelint": "npm run --silent gen",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretest": "npm run --silent gen",
    "test": "vitest run",
    "pretest:wasm": "npm run --silent gen",
    "test:wasm": "vitest run --config vitest.wasm.config.ts",
    "pree2e": "npm run --silent gen",
    "e2e": "playwright test",
    "pree2e:online": "npm run --silent gen",
    "e2e:online": "playwright test --config playwright.online.config.ts",
    "pree2e:container": "npm run --silent gen",
    "e2e:container": "playwright test --config playwright.container.config.ts",
    "pree2e:balance": "npm run --silent gen",
    "e2e:balance": "playwright test --config playwright.balance.config.ts",
    "pree2e:k3d": "npm run --silent gen",
    "e2e:k3d": "playwright test --config playwright.k3d.config.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "26.10.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
